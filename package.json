{
  "name": "@markdlabrecque/sawmill",
  "version": "1.1.1",
  "description": "Build and run a Sawmill millyard",
  "type": "module",
  "bin": {
    "mill": "dist/src/bin.js",
    "mill-draft-screen": "dist/src/draft-screen.js",
    "mill-learn-screen": "dist/src/learn-screen.js"
  },
  "exports": {
    ".": "./dist/src/cli.js",
    "./draft-screening": "./dist/src/draft-screening.js",
    "./learn-screening": "./dist/src/learn-screening.js"
  },
  "files": [
    "dist/src",
    "templates",
    "roles",
    ".claude-plugin",
    "plugins"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc && node dist/src/stamp-build.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=120000 dist/test/*.test.js && node --test --test-timeout=120000 dist/test/process-permissions.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commonmark": "^0.31.2",
    "playwright-core": "^1.64.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": { "optional": true }
  },
  "devDependencies": {
    "@types/commonmark": "^0.27.10",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
